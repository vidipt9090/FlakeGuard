.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.parquet
/data/
/artifacts/
/out/
!tests/data/
*.log
.env
*.env
.cache/


# Build output of the `report` stage. Regenerated by
# `python scripts/build_static_report.py`; the pipeline deploys it from the
# artifact, so a committed copy would only ever be stale.
/site/

# Tool caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit.xml
pip-freeze.txt

# Frontend build output and dependencies. `npm ci` restores node_modules from
# package-lock.json; the bundle is rebuilt by the `ui` pipeline stage and
# carried forward as an artifact, so a committed copy would only be stale.
/frontend/node_modules/
/frontend/dist/
/.cache/
/frontend/*.tsbuildinfo
